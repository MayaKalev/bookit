@model ServiceFormViewModel
@{
    ViewData["Title"] = "Add service";
}

<h1 class="h3 mb-3">Add service</h1>

<div class="row">
    <div class="col-md-6">
        @* asp-action="Create" + method="post" → POST /Services/Create.
           The form Tag Helper also adds a hidden anti-forgery token automatically. *@
        <form asp-action="Create" method="post">
            <partial name="_ServiceForm" model="Model" />

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@* Loads jQuery Validation so errors show instantly in the browser, before submitting. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

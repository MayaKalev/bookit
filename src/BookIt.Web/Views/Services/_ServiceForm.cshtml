@* A partial view: a piece of HTML shared by Create.cshtml and Edit.cshtml. *@
@model ServiceFormViewModel

@* Shows errors that aren't tied to one field. *@
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@* Tag Helpers: asp-for="Name" generates id, name, value, the <label> text,
   and data-val-* attributes for browser-side validation — all from the ViewModel. *@
<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-sm-6 mb-3">
        <label asp-for="DurationMinutes" class="form-label"></label>
        <input asp-for="DurationMinutes" class="form-control" step="5" />
        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
    </div>
    <div class="col-sm-6 mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
</div>

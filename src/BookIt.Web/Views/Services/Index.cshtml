@model List<Service>
@{
    ViewData["Title"] = "Services";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Services</h1>
    <a class="btn btn-primary" asp-action="Create">+ Add service</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">No services yet. Add your first one so customers can book.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Duration</th>
                <th>Price</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var service in Model)
            {
                <tr class="@(service.IsActive ? "" : "text-muted")">
                    <td>
                        <strong>@service.Name</strong>
                        @if (!string.IsNullOrEmpty(service.Description))
                        {
                            <div class="small text-muted">@service.Description</div>
                        }
                    </td>
                    <td>@service.DurationMinutes min</td>
                    <td>@service.Price.ToString("0.00")</td>
                    <td>
                        @if (service.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Hidden</span>
                        }
                    </td>
                    <td class="text-end">
                        @* asp-route-id adds the id to the URL: /Services/Edit/2 *@
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@service.Id">Edit</a>

                        @* Changing data must be a POST (a form), never a plain link (GET). *@
                        <form asp-action="ToggleActive" asp-route-id="@service.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-@(service.IsActive ? "warning" : "success")">
                                @(service.IsActive ? "Hide" : "Show")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
